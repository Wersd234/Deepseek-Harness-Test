# 复制本文件为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交
# ---- Discord（Developer Portal → Bot → Token）----
DISCORD_TOKEN=把-bot-token-填进来
# dev 测试服的 Guild ID（服务器右键 → 复制服务器 ID）；填了则 slash 命令秒级同步到该服（主文档 §5.4）
DEV_GUILD_ID=
# ---- PTV 凭证（主文档 §11.1 用于 curl 验证）----
PTV_DEVID=
PTV_KEY=
PTV_API_BASE=https://timetableapi.ptv.vic.gov.au
